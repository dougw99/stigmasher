pacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004060"],"group_tree":[{"id":"V-263612","title":"SRG-APP-000840","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000840"},{"uuid":"2645364f-73ff-4e78-b582-4114f3bf2665","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263613","rule_id":"SV-263613r982495","rule_id_src":"SV-263613r982495_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000845-DB-000220","group_title":"The DBMS must, for password-based authentication, verify that when users create or update passwords, the passwords are not found on the list of commonly-used, expected, or compromised passwords in IA-5 (1) (a).","rule_title":"The DBMS must, for password-based authentication, verify that when users create or update passwords, the passwords are not found on the list of commonly-used, expected, or compromised passwords in IA-5 (1) (a).","fix_text":"Configure the DBMS to verify when users create or update passwords, that the passwords are not found on the list of commonly-used, expected, or compromised passwords in IA-5 (1) (a).","false_positives":"","false_negatives":"","discussion":"Password-based authentication applies to passwords regardless of whether they are used in single-factor or multifactor authentication. Long passwords or passphrases are preferable over shorter passwords. Enforced composition rules provide marginal security benefits while decreasing usability. However, organizations may choose to establish certain rules for password generation (e.g., minimum character length for long passwords) under certain circumstances and can enforce this requirement in IA-5(1)(h). Account recovery can occur, for example, in situations when a password is forgotten. Cryptographically protected passwords include salted one-way cryptographic hashes of passwords. The list of commonly used, compromised, or expected passwords includes passwords obtained from previous breach corpuses, dictionary words, and repetitive or sequential characters. The list includes context-specific words, such as the name of the service, username, and derivatives thereof.","check_content":"Verify the DBMS is configured to verify when users create or update passwords, that the passwords are not found on the list of commonly-used, expected, or compromised passwords in IA-5 (1) (a).\n\nIf the DBMS is not configured to verify when users create or update passwords, that the passwords are not found on the list of commonly-used, expected, or compromised passwords in IA-5 (1) (a), this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004061"],"group_tree":[{"id":"V-263613","title":"SRG-APP-000845","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000845"},{"uuid":"a89855bd-ccf8-4cbf-97f5-a87a27a9194d","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263614","rule_id":"SV-263614r982497","rule_id_src":"SV-263614r982497_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000855-DB-000240","group_title":"The DBMS must, for password-based authentication, require immediate selection of a new password upon account recovery.","rule_title":"The DBMS must, for password-based authentication, require immediate selection of a new password upon account recovery.","fix_text":"Configure the DBMS to require immediate selection of a new password upon account recovery.","false_positives":"","false_negatives":"","discussion":"Password-based authentication applies to passwords regardless of whether they are used in single-factor or multifactor authentication. Long passwords or passphrases are preferable over shorter passwords. Enforced composition rules provide marginal security benefits while decreasing usability. However, organizations may choose to establish certain rules for password generation (e.g., minimum character length for long passwords) under certain circumstances and can enforce this requirement in IA-5(1)(h). Account recovery can occur, for example, in situations when a password is forgotten. Cryptographically protected passwords include salted one-way cryptographic hashes of passwords. The list of commonly used, compromised, or expected passwords includes passwords obtained from previous breach corpuses, dictionary words, and repetitive or sequential characters. The list includes context-specific words, such as the name of the service, username, and derivatives thereof.","check_content":"Verify the DBMS is configured to require immediate selection of a new password upon account recovery.\n\nIf the DBMS is not configured to require immediate selection of a new password upon account recovery, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004063"],"group_tree":[{"id":"V-263614","title":"SRG-APP-000855","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000855"},{"uuid":"30fc442b-9456-4738-862c-a2b266ad14c0","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263615","rule_id":"SV-263615r982499","rule_id_src":"SV-263615r982499_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000860-DB-000250","group_title":"The DBMS must, for password-based authentication, allow user selection of long passwords and passphrases, including spaces and all printable characters.","rule_title":"The DBMS must, for password-based authentication, allow user selection of long passwords and passphrases, including spaces and all printable characters.","fix_text":"Configure the DBMS to allow user selection of long passwords and passphrases, including spaces and all printable characters.","false_positives":"","false_negatives":"","discussion":"Password-based authentication applies to passwords regardless of whether they are used in single-factor or multifactor authentication. Long passwords or passphrases are preferable over shorter passwords. Enforced composition rules provide marginal security benefits while decreasing usability. However, organizations may choose to establish certain rules for password generation (e.g., minimum character length for long passwords) under certain circumstances and can enforce this requirement in IA-5(1)(h). Account recovery can occur, for example, in situations when a password is forgotten. Cryptographically protected passwords include salted one-way cryptographic hashes of passwords. The list of commonly used, compromised, or expected passwords includes passwords obtained from previous breach corpuses, dictionary words, and repetitive or sequential characters. The list includes context-specific words, such as the name of the service, username, and derivatives thereof.","check_content":"Verify the DBMS is configured to allow user selection of long passwords and passphrases, including spaces and all printable characters.\n\nIf the DBMS is not configured to allow user selection of long passwords and passphrases, including spaces and all printable characters, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004064"],"group_tree":[{"id":"V-263615","title":"SRG-APP-000860","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000860"},{"uuid":"6b5d6f7f-f017-41dd-ab74-2503117b594e","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263616","rule_id":"SV-263616r982501","rule_id_src":"SV-263616r982501_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000865-DB-000260","group_title":"The DBMS must, for password-based authentication, employ automated tools to assist the user in selecting strong password authenticators.","rule_title":"The DBMS must, for password-based authentication, employ automated tools to assist the user in selecting strong password authenticators.","fix_text":"Configure the DBMS to employ automated tools to assist the user in selecting strong password authenticators.","false_positives":"","false_negatives":"","discussion":"Password-based authentication applies to passwords regardless of whether they are used in single-factor or multifactor authentication. Long passwords or passphrases are preferable over shorter passwords. Enforced composition rules provide marginal security benefits while decreasing usability. However, organizations may choose to establish certain rules for password generation (e.g., minimum character length for long passwords) under certain circumstances and can enforce this requirement in IA-5(1)(h). Account recovery can occur, for example, in situations when a password is forgotten. Cryptographically protected passwords include salted one-way cryptographic hashes of passwords. The list of commonly used, compromised, or expected passwords includes passwords obtained from previous breach corpuses, dictionary words, and repetitive or sequential characters. The list includes context-specific words, such as the name of the service, username, and derivatives thereof.","check_content":"Verify the DBMS is configured to employ automated tools to assist the user in selecting strong password authenticators.\n\nIf the DBMS is not configured to employ automated tools to assist the user in selecting strong password authenticators, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004065"],"group_tree":[{"id":"V-263616","title":"SRG-APP-000865","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000865"},{"uuid":"20c94635-857e-4742-aff5-0c0ece676184","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263617","rule_id":"SV-263617r982009","rule_id_src":"SV-263617r982009_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000875-DB-000280","group_title":"The DBMS must, for public key-based authentication, implement a local cache of revocation data to support path discovery and validation.","rule_title":"The DBMS must, for public key-based authentication, implement a local cache of revocation data to support path discovery and validation.","fix_text":"Configure the DBMS to implement a local cache of revocation data to support path discovery and validation.","false_positives":"","false_negatives":"","discussion":"Public key cryptography is a valid authentication mechanism for individuals, machines, and devices. For PKI solutions, status information for certification paths includes certificate revocation lists or certificate status protocol responses. For PIV cards, certificate validation involves the construction and verification of a certification path to the Common Policy Root trust anchor, which includes certificate policy processing. Implementing a local cache of revocation data to support path discovery and validation also supports system availability in situations where organizations are unable to access revocation information via the network.","check_content":"Verify the DBMS is configured to implement a local cache of revocation data to support path discovery and validation.\n\nIf the DBMS is not configured to implement a local cache of revocation data to support path discovery and validation, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004068"],"group_tree":[{"id":"V-263617","title":"SRG-APP-000875","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000875"},{"uuid":"6dcd4e8a-8021-4d61-a613-6cef84af7ef4","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263618","rule_id":"SV-263618r982503","rule_id_src":"SV-263618r982503_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000880-DB-000290","group_title":"The DBMS must protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.","rule_title":"The DBMS must protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.","fix_text":"Configure the DBMS to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.","false_positives":"","false_negatives":"","discussion":"Nonlocal maintenance and diagnostic activities are conducted by individuals who communicate through either an external or internal network. Communications paths can be logically separated using encryption.","check_content":"Verify the DBMS is configured to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.\n\nIf the DBMS is not configured to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004192"],"group_tree":[{"id":"V-263618","title":"SRG-APP-000880","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000880"},{"uuid":"96befa93-aa13-4354-a912-035fb34876fb","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263619","rule_id":"SV-263619r982505","rule_id_src":"SV-263619r982505_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000910-DB-000300","group_title":"The DBMS must include only approved trust anchors in trust stores or certificate stores managed by the organization.","rule_title":"The DBMS must include only approved trust anchors in trust stores or certificate stores managed by the organization.","fix_text":"Configure the DBMS to include only approved trust anchors in trust stores or certificate stores managed by the organization.","false_positives":"","false_negatives":"","discussion":"Public key infrastructure (PKI) certificates are certificates with visibility external to organizational systems and certificates related to the internal operations of systems, such as application-specific time services. In cryptographic systems with a hierarchical structure, a trust anchor is an authoritative source (i.e., a certificate authority) for which trust is assumed and not derived. A root certificate for a PKI system is an example of a trust anchor. A trust store or certificate store maintains a list of trusted root certificates.","check_content":"Verify the DBMS is configured to include only approved trust anchors in trust stores or certificate stores managed by the organization.\n\nIf the DBMS is not configured to include only approved trust anchors in trust stores or certificate stores managed by the organization, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004909"],"group_tree":[{"id":"V-263619","title":"SRG-APP-000910","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000910"},{"uuid":"9fc79ad4-a49a-4faf-86a2-0e0f10ddc8da","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263620","rule_id":"SV-263620r982507","rule_id_src":"SV-263620r982507_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000915-DB-000310","group_title":"The DBMS must provide protected storage for cryptographic keys with organization-defined safeguards and/or hardware protected key store.","rule_title":"The DBMS must provide protected storage for cryptographic keys with organization-defined safeguards and/or hardware protected key store.","fix_text":"Configure the DBMS to provide protected storage for cryptographic keys with organization-defined safeguards and/or hardware protected key store.","false_positives":"","false_negatives":"","discussion":"A Trusted Platform Module (TPM) is an example of a hardware-protected data store that can be used to protect cryptographic keys.","check_content":"Verify the DBMS is configured to provide protected storage for cryptographic keys with organization-defined safeguards and/or hardware protected key store.\n\nIf the DBMS is not configured to provide protected storage for cryptographic keys with organization-defined safeguards and/or hardware protected key store, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004910"],"group_tree":[{"id":"V-263620","title":"SRG-APP-000915","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000915"},{"uuid":"33fc8755-571a-4a6a-b206-a8a070bec8fa","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263621","rule_id":"SV-263621r982509","rule_id_src":"SV-263621r982509_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000920-DB-000320","group_title":"The DBMS must synchronize system clocks within and between systems or system components.","rule_title":"The DBMS must synchronize system clocks within and between systems or system components.","fix_text":"Configure the DBMS to synchronize system clocks within and between systems or system components.","false_positives":"","false_negatives":"","discussion":"Time synchronization of system clocks is essential for the correct execution of many system services, including identification and authentication processes that involve certificates and time-of-day restrictions as part of access control. Denial of service or failure to deny expired credentials may result without properly synchronized clocks within and between systems and system components. Time is commonly expressed in Coordinated Universal Time (UTC), a modern continuation of Greenwich Mean Time (GMT), or local time with an offset from UTC. The granularity of time measurements refers to the degree of synchronization between system clocks and reference clocks, such as clocks synchronizing within hundreds of milliseconds or tens of milliseconds. Organizations may define different time granularities for system components. Time service can be critical to other security capabilities such as access control and identification and authentication depending on the nature of the mechanisms used to support the capabilities.","check_content":"Verify the DBMS is configured to synchronize system clocks within and between systems or system components.\n\nIf the DBMS is not configured to synchronize system clocks within and between systems or system components, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004922"],"group_tree":[{"id":"V-263621","title":"SRG-APP-000920","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000920"},{"uuid":"3e21a576-d852-4aca-ac8b-b0db611eb0a1","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-263622","rule_id":"SV-263622r982511","rule_id_src":"SV-263622r982511_rule","weight":"10.0","classification":"Unclassified","severity":"medium","rule_version":"SRG-APP-000925-DB-000330","group_title":"The DBMS must compare the internal system clocks on an organization-defined frequency with organization-defined authoritative time source.","rule_title":"The DBMS must compare the internal system clocks on an organization-defined frequency with organization-defined authoritative time source.","fix_text":"Configure the DBMS to compare the internal system clocks on an organization-defined frequency with organization-defined authoritative time source.","false_positives":"","false_negatives":"","discussion":"Synchronization of internal system clocks with an authoritative source provides uniformity of time stamps for systems with multiple system clocks and systems connected over a network.","check_content":"Verify the DBMS is configured to compare the internal system clocks on an organization-defined frequency with organization-defined authoritative time source.\n\nIf the DBMS is not configured to compare the internal system clocks on an organization-defined frequency with organization-defined authoritative time source, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-004923"],"group_tree":[{"id":"V-263622","title":"SRG-APP-000925","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-000925"},{"uuid":"0744c36d-253f-4249-addc-459eb87afa3c","stig_uuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","target_key":null,"stig_ref":null,"group_id":"V-278969","rule_id":"SV-278969r1137670","rule_id_src":"SV-278969r1137670_rule","weight":"10.0","classification":"Unclassified","severity":"high","rule_version":"SRG-APP-001035-DB-000323","group_title":"The DBMS must be a version supported by the vendor.","rule_title":"The DBMS must be a version supported by the vendor.","fix_text":"Upgrade or install a version of the DBMS supported by the vendor.","false_positives":"","false_negatives":"","discussion":"Unsupported software and systems should not be used because fixes to newly identified bugs will not be implemented by the vendor. The lack of support can result in potential vulnerabilities.\n\nSoftware and systems at unsupported servicing levels or releases will not receive security updates for new vulnerabilities, which leaves them subject to exploitation.\n\nWhen maintenance updates and patches are no longer available, software is no longer considered supported and should be upgraded or decommissioned.","check_content":"Verify the DBMS is  a version supported by the vendor.\n\nIf the DBMS is not a version supported by the vendor, this is a finding.","documentable":"false","mitigations":"","potential_impacts":"","third_party_tools":"","mitigation_control":"","responsibility":"","security_override_guidance":"","ia_controls":"","check_content_ref":{"href":"Database_Generic_SRG.xml","name":"M"},"legacy_ids":[],"ccis":["CCI-003376"],"group_tree":[{"id":"V-278969","title":"SRG-APP-001035","description":"<GroupDescription></GroupDescription>"}],"createdAt":"2026-10-20T20:39:38.693Z","updatedAt":"2026-10-20T20:39:38.693Z","STIGUuid":"86cf1068-3987-492f-a5e0-eb514c78aeeb","status":"not_reviewed","overrides":{},"comments":"","finding_details":"","srg_id":"SRG-APP-001035"}]}],"active":false,"mode":2,"has_path":true,"target_data":{"target_type":"Computing","host_name":"","ip_address":"","mac_address":"","fqdn":"","comments":"","role":"None","is_web_database":false,"technology_area":"","web_db_site":"","web_db_instance":"","classification":null},"cklb_version":"1.0"}